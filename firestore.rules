rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.admin == true;
    }

    // ── Usuarios ──────────────────────────────────────────────────────────────
    match /usuarios/{uid} {
      // Solo el propio usuario y los admins pueden leer el perfil completo
      allow read: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
        esAdmin() ||
        (request.auth.uid == uid &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['admin', 'rol', 'bloqueado', 'advertencia', 'reputacion',
                    'noShows', 'partidosJugados', 'deudaPendiente',
                    'deudaPartidoId', 'penalizacionHasta']) &&
         // La cédula solo se puede establecer una vez (cuando no está registrada aún)
         (
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cedula']) ||
           resource.data.get('cedula', null) == null
         )
        )
      );
    }

    // ── Usuarios públicos ─────────────────────────────────────────────────────
    match /usuarios_publicos/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || esAdmin());
    }

    // ── Mensajes directos ─────────────────────────────────────────────────────
    match /conversaciones/{convId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantes;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantes;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantes;
      allow delete: if false;

      match /mensajes/{mensajeId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversaciones/$(convId)).data.participantes;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversaciones/$(convId)).data.participantes
          && request.resource.data.de == request.auth.uid
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 500;
        allow update, delete: if false;
      }
    }

    // ── Códigos de verificación (solo Cloud Functions) ────────────────────────
    match /codigosVerificacion/{docId} {
      allow read, write: if false;
    }

    // ── Partidos ──────────────────────────────────────────────────────────────
    match /partidos/{partidoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        esAdmin() ||
        request.auth.uid == resource.data.creadoPor ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['jugadores', 'jugadoresAnotados', 'activo', 'estado',
                    'confirmadoEn', 'rechazadoEn', 'motivoRechazo',
                    'pagoCanchaConfirmado', 'pagoCanchaFecha', 'pagos',
                    'notificacionIncompletoEn', 'confirmadoIncompleto',
                    'canceladoAutomaticoEn', 'modoBuscoRival',
                    'rivalAceptadoPor', 'rivalAceptadoEn'])
      );
      allow delete: if request.auth != null && (
        esAdmin() || request.auth.uid == resource.data.creadoPor
      );

      // ── Chat del partido ───────────────────────────────────────────────────
      match /mensajes/{mensajeId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/partidos/$(partidoId)).data.jugadores;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/partidos/$(partidoId)).data.jugadores
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 500;
        allow update, delete: if false;
      }
    }

    // ── Canchas ───────────────────────────────────────────────────────────────
    match /canchas/{canchaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Horarios bloqueados ────────────────────────────────────────────────────
    match /horarios_bloqueados/{bloqueId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Reservas ──────────────────────────────────────────────────────────────
    match /reservas/{reservaId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // ── Pagos ─────────────────────────────────────────────────────────────────
    match /pagos/{pagoId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // ── Cédulas de identidad ───────────────────────────────────────────────────
    // Colección privada: solo se usa para garantizar unicidad de cédula por cuenta.
    // El uid de cada documento es el número de cédula normalizado (8 dígitos).
    match /cedulas/{cedula} {
      // Cualquier usuario autenticado puede verificar si una cédula ya existe (sin ver el uid)
      allow get: if request.auth != null;
      // No se puede listar la colección completa
      allow list: if false;
      // El propio usuario puede crear su reserva de cédula (vía transacción)
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // Solo el admin puede modificar o eliminar cédulas registradas
      allow update, delete: if esAdmin();
    }
  }
}
